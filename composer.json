{
    "name": "chriskayayling/ascensionplatform",
    "description": "AscensionPlatform - a CMS with a built-in administration system, API key management, and an integrated QA toolchain.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Kay-Ayling",
            "email": "chris@chriskayayling.co.uk"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-sqlite3": "*",
        "ext-pdo_sqlite": "*",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "twig/twig": "^3.0",
        "kint-php/kint": "*",
        "matthiasmullie/minify": "*",
        "spatie/ignition": "*",
        "guzzlehttp/guzzle": "^7.0",
        "php-amqplib/php-amqplib": ">=v3.5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "phpdocumentor/shim": "^3.4",
        "zircote/swagger-php": "^4.9"
    },
    "autoload": {
        "psr-4": {
            "Ascension\\": "src/"
        },
        "psr-0": {
            "": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ascension\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=tools/phpcs.xml lib src",
        "lint:fix": "phpcbf --standard=tools/phpcs.xml lib src",
        "docs": "phpdoc run -d src -d lib -t build/reports/docs",
        "swagger": "openapi lib --output build/reports/openapi.json"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpdocumentor/shim": true
        }
    },
    "minimum-stability": "stable"
}
