<?xml version="1.0"?>
<ruleset name="AscensionPlatform">
    <description>AscensionPlatform coding standard - PSR-12, as documented for contributors.</description>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="140"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
